                                                        <SW-IMPL-POLICY>STANDARD</SW-IMPL-POLICY>
                                                    </SW-DATA-DEF-PROPS-CONDITIONAL>
                                                </SW-DATA-DEF-PROPS-VARIANTS>
                                            </SW-DATA-DEF-PROPS>
                                            <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/STCW_pkg/STCW_dt/ApplDataTypes/T_BOOLEAN</TYPE-TREF>
                                            <INIT-VALUE>
                                                <CONSTANT-REFERENCE>
                                                    <SHORT-LABEL>STCWke_b_OnlyAllowBrakeRegenInForward</SHORT-LABEL>
                                                    <CONSTANT-REF DEST="CONSTANT-SPECIFICATION">/STCW_pkg/STCW_dt/Ground/STCWke_b_OnlyAllowBrakeRegenInForward</CONSTANT-REF>
                                                </CONSTANT-REFERENCE>
                                            </INIT-VALUE>
                                        </PARAMETER-DATA-PROTOTYPE>
