                                        <PARAMETER-DATA-PROTOTYPE UUID="7cdecb65-26a6-5b09-3d07-912e837ffaa4">
                                            <SHORT-NAME>STCWke_e_CluToEmFactMethod</SHORT-NAME>
                                            <DESC>
                                                <L-2 L="FOR-ALL">###Description
Selection of method for scaling capabilities with clutch pedal position.

###Usage
Simple scaling: independant of drag point
CluCmdMap: Map with scale factor depending on clutch command.
DragPointDistance: Map with scale factor depending on relative distance (pos/neg) from drag point. Clu pedal at drag point means relative distance = zero!

###Calibration
Only for manual transmissions
</L-2>
                                            </DESC>
                                            <CATEGORY>VALUE</CATEGORY>
                                            <SW-DATA-DEF-PROPS>
                                                <SW-DATA-DEF-PROPS-VARIANTS>
                                                    <SW-DATA-DEF-PROPS-CONDITIONAL>
                                                        <SW-CALIBRATION-ACCESS>READ-WRITE</SW-CALIBRATION-ACCESS>
                                                        <SW-IMPL-POLICY>STANDARD</SW-IMPL-POLICY>
                                                    </SW-DATA-DEF-PROPS-CONDITIONAL>
                                                </SW-DATA-DEF-PROPS-VARIANTS>
                                            </SW-DATA-DEF-PROPS>
                                            <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/STCW_pkg/STCW_dt/ApplDataTypes/STCWte_e_CluToEmType</TYPE-TREF>
                                            <INIT-VALUE>
                                                <CONSTANT-REFERENCE>
                                                    <SHORT-LABEL>STCWke_e_CluToEmFactMethod</SHORT-LABEL>
                                                    <CONSTANT-REF DEST="CONSTANT-SPECIFICATION">/STCW_pkg/STCW_dt/Ground/STCWke_e_CluToEmFactMethod</CONSTANT-REF>
                                                </CONSTANT-REFERENCE>
                                            </INIT-VALUE>
                                        </PARAMETER-DATA-PROTOTYPE>
