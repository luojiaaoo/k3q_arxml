                                        <PARAMETER-DATA-PROTOTYPE UUID="0d424b2d-9dbe-5670-6238-ffc0120bb22d">
                                            <SHORT-NAME>STCWke_dM_BrakeRegenLowPedalDsbl</SHORT-NAME>
                                            <DESC>
                                                <L-2 L="FOR-ALL">Defines how fast brake regen torque capability is allowed to decrease when Low Pedal Disabled is set to True

NOTE this calibration also rate limiting the brake regen capability at all times not only when brake regen is enabled





</L-2>
                                            </DESC>
                                            <CATEGORY>VALUE</CATEGORY>
                                            <SW-DATA-DEF-PROPS>
                                                <SW-DATA-DEF-PROPS-VARIANTS>
                                                    <SW-DATA-DEF-PROPS-CONDITIONAL>
                                                        <SW-CALIBRATION-ACCESS>READ-WRITE</SW-CALIBRATION-ACCESS>
                                                        <SW-IMPL-POLICY>STANDARD</SW-IMPL-POLICY>
                                                    </SW-DATA-DEF-PROPS-CONDITIONAL>
                                                </SW-DATA-DEF-PROPS-VARIANTS>
                                            </SW-DATA-DEF-PROPS>
                                            <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/STCW_pkg/STCW_dt/ApplDataTypes/T_M_Nm_Float32_n2000to0</TYPE-TREF>
                                            <INIT-VALUE>
