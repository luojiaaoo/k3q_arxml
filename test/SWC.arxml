                                            </INIT-VALUE>
                                        </PARAMETER-DATA-PROTOTYPE>
                                        <PARAMETER-DATA-PROTOTYPE UUID="428a0114-22eb-5b54-7fbf-298339330ded">
                                            <SHORT-NAME>STCWke_b_UseP4MotorForBrakeRegenCap</SHORT-NAME>
                                            <DESC>
                                                <L-2 L="FOR-ALL">If true, available P4 motor torque is used for brake regen capabilities</L-2>
                                            </DESC>
                                            <CATEGORY>BOOLEAN</CATEGORY>
                                            <SW-DATA-DEF-PROPS>
                                                <SW-DATA-DEF-PROPS-VARIANTS>
                                                    <SW-DATA-DEF-PROPS-CONDITIONAL>
                                                        <SW-CALIBRATION-ACCESS>READ-WRITE</SW-CALIBRATION-ACCESS>
                                                        <SW-IMPL-POLICY>STANDARD</SW-IMPL-POLICY>
                                                    </SW-DATA-DEF-PROPS-CONDITIONAL>
                                                </SW-DATA-DEF-PROPS-VARIANTS>
                                            </SW-DATA-DEF-PROPS>
                                            <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/STCW_pkg/STCW_dt/ApplDataTypes/T_BOOLEAN</TYPE-TREF>
                                            <INIT-VALUE>
                                                <CONSTANT-REFERENCE>
                                                    <SHORT-LABEL>STCWke_b_UseP4MotorForBrakeRegenCap</SHORT-LABEL>
                                                    <CONSTANT-REF DEST="CONSTANT-SPECIFICATION">/STCW_pkg/STCW_dt/Ground/STCWke_b_UseP4MotorForBrakeRegenCap</CONSTANT-REF>
                                                </CONSTANT-REFERENCE>
                                            </INIT-VALUE>
                                        </PARAMETER-DATA-PROTOTYPE>
                                        <PARAMETER-DATA-PROTOTYPE UUID="e522dc8e-2b00-58bb-9e85-1c40bcf3ec09">
                                            <SHORT-NAME>STCWke_b_UsePredictedToDetectTransCntrl</SHORT-NAME>
                                            <DESC>
                                                <L-2 L="FOR-ALL">###Description
Use the transmission predicted torque control limit to say that the transmission is in control of the P1 system.

###Note
This shall be calibrated together with calibrations in TIRC. This calibration shall be true if TIRC is calibrated to lower the P1 immediate command with the Predicted request
</L-2>
                                            </DESC>
                                            <CATEGORY>BOOLEAN</CATEGORY>
                                            <SW-DATA-DEF-PROPS>
                                                <SW-DATA-DEF-PROPS-VARIANTS>
                                                    <SW-DATA-DEF-PROPS-CONDITIONAL>
                                                        <SW-CALIBRATION-ACCESS>READ-WRITE</SW-CALIBRATION-ACCESS>
                                                        <SW-IMPL-POLICY>STANDARD</SW-IMPL-POLICY>
                                                    </SW-DATA-DEF-PROPS-CONDITIONAL>
                                                </SW-DATA-DEF-PROPS-VARIANTS>
                                            </SW-DATA-DEF-PROPS>
                                            <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/STCW_pkg/STCW_dt/ApplDataTypes/T_BOOLEAN</TYPE-TREF>
                                            <INIT-VALUE>
                                                <CONSTANT-REFERENCE>
                                                    <SHORT-LABEL>STCWke_b_UsePredictedToDetectTransCntrl</SHORT-LABEL>
                                                    <CONSTANT-REF DEST="CONSTANT-SPECIFICATION">/STCW_pkg/STCW_dt/Ground/STCWke_b_UsePredictedToDetectTransCntrl</CONSTANT-REF>
                                                </CONSTANT-REFERENCE>
                                            </INIT-VALUE>
                                        </PARAMETER-DATA-PROTOTYPE>
                                        <PARAMETER-DATA-PROTOTYPE UUID="e72f7f16-d524-5303-0bfd-05c3dc9f2228">
                                            <SHORT-NAME>STCWke_b_UsePrplsAllwd</SHORT-NAME>
                                            <DESC>
                                                <L-2 L="FOR-ALL">###Description
Decides whether Propulsion Allowed is used on (P1 + P3) wheel capabilities.

###Usage

###Calibration Note
ISG: Value shall be FALSE.
PHEV: Value shall be TRUE.
</L-2>
                                            </DESC>
                                            <CATEGORY>BOOLEAN</CATEGORY>
                                            <SW-DATA-DEF-PROPS>
                                                <SW-DATA-DEF-PROPS-VARIANTS>
                                                    <SW-DATA-DEF-PROPS-CONDITIONAL>
                                                        <SW-CALIBRATION-ACCESS>READ-WRITE</SW-CALIBRATION-ACCESS>
                                                        <SW-IMPL-POLICY>STANDARD</SW-IMPL-POLICY>
                                                    </SW-DATA-DEF-PROPS-CONDITIONAL>
                                                </SW-DATA-DEF-PROPS-VARIANTS>
                                            </SW-DATA-DEF-PROPS>
                                            <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/STCW_pkg/STCW_dt/ApplDataTypes/T_BOOLEAN</TYPE-TREF>
                                            <INIT-VALUE>
                                                <CONSTANT-REFERENCE>
                                                    <SHORT-LABEL>STCWke_b_UsePrplsAllwd</SHORT-LABEL>
                                                    <CONSTANT-REF DEST="CONSTANT-SPECIFICATION">/STCW_pkg/STCW_dt/Ground/STCWke_b_UsePrplsAllwd</CONSTANT-REF>
                                                </CONSTANT-REFERENCE>
                                            </INIT-VALUE>
                                        </PARAMETER-DATA-PROTOTYPE>
                                        <PARAMETER-DATA-PROTOTYPE UUID="75b3b1f8-cb53-5b5f-9bb8-5d21f9adc2fb">
                                            <SHORT-NAME>STCWke_b_UseTotCapForBrkRegenCapCalc</SHORT-NAME>
                                            <DESC>
                                                <L-2 L="FOR-ALL">###Description
Defines which capaility that shall be used to calculate the brake regen capability

###Usage
If true brake regen can be allowed to use the total driver torque capability. If false brake regen is calculated from the Electric torque capability at wheels.
</L-2>
                                            </DESC>
                                            <CATEGORY>BOOLEAN</CATEGORY>
                                            <SW-DATA-DEF-PROPS>
                                                <SW-DATA-DEF-PROPS-VARIANTS>
                                                    <SW-DATA-DEF-PROPS-CONDITIONAL>
                                                        <SW-CALIBRATION-ACCESS>READ-WRITE</SW-CALIBRATION-ACCESS>
                                                        <SW-IMPL-POLICY>STANDARD</SW-IMPL-POLICY>
                                                    </SW-DATA-DEF-PROPS-CONDITIONAL>
                                                </SW-DATA-DEF-PROPS-VARIANTS>
                                            </SW-DATA-DEF-PROPS>
                                            <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/STCW_pkg/STCW_dt/ApplDataTypes/T_BOOLEAN</TYPE-TREF>
                                            <INIT-VALUE>
                                                <CONSTANT-REFERENCE>
                                                    <SHORT-LABEL>STCWke_b_UseTotCapForBrkRegenCapCalc</SHORT-LABEL>
                                                    <CONSTANT-REF DEST="CONSTANT-SPECIFICATION">/STCW_pkg/STCW_dt/Ground/STCWke_b_UseTotCapForBrkRegenCapCalc</CONSTANT-REF>
                                                </CONSTANT-REFERENCE>
                                            </INIT-VALUE>
                                        </PARAMETER-DATA-PROTOTYPE>
