                                                    <SHORT-LABEL>STCWke_dM_BrakeRegenLowPedalDsbl</SHORT-LABEL>
                                                    <CONSTANT-REF DEST="CONSTANT-SPECIFICATION">/STCW_pkg/STCW_dt/Ground/STCWke_dM_BrakeRegenLowPedalDsbl</CONSTANT-REF>
                                                </CONSTANT-REFERENCE>
                                            </INIT-VALUE>
                                        </PARAMETER-DATA-PROTOTYPE>
                                        <PARAMETER-DATA-PROTOTYPE UUID="df5ab7ff-4763-5569-9df8-426bfafe2617">
                                            <SHORT-NAME>STCWke_dM_BrakeRegenLowPedalEnbl</SHORT-NAME>
                                            <DESC>
                                                <L-2 L="FOR-ALL">Defines how fast brake regen torque capability is allowed to increase when Low Pedal Disabled is set to zero.

NOTE this calibration also rate limiting the brake regen capability at all times not only when brake regen is enabled





</L-2>
                                            </DESC>
                                            <CATEGORY>VALUE</CATEGORY>
                                            <SW-DATA-DEF-PROPS>
                                                <SW-DATA-DEF-PROPS-VARIANTS>
                                                    <SW-DATA-DEF-PROPS-CONDITIONAL>
                                                        <SW-CALIBRATION-ACCESS>READ-WRITE</SW-CALIBRATION-ACCESS>
                                                        <SW-IMPL-POLICY>STANDARD</SW-IMPL-POLICY>
                                                    </SW-DATA-DEF-PROPS-CONDITIONAL>
                                                </SW-DATA-DEF-PROPS-VARIANTS>
                                            </SW-DATA-DEF-PROPS>
                                            <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/STCW_pkg/STCW_dt/ApplDataTypes/T_M_Nm_Float32_0to1000</TYPE-TREF>
                                            <INIT-VALUE>
                                                <CONSTANT-REFERENCE>
                                                    <SHORT-LABEL>STCWke_dM_BrakeRegenLowPedalEnbl</SHORT-LABEL>
                                                    <CONSTANT-REF DEST="CONSTANT-SPECIFICATION">/STCW_pkg/STCW_dt/Ground/STCWke_dM_BrakeRegenLowPedalEnbl</CONSTANT-REF>
                                                </CONSTANT-REFERENCE>
                                            </INIT-VALUE>
                                        </PARAMETER-DATA-PROTOTYPE>
                                        <PARAMETER-DATA-PROTOTYPE UUID="f2214a6f-b54f-57a8-cdb3-b4705582afab">
                                            <SHORT-NAME>STCWke_Cnt_HoldWheelCapsAllowed</SHORT-NAME>
                                            <DESC>
                                                <L-2 L="FOR-ALL">Samples of delay until wheel torque capabilities is shutdown after the \real\ propulsion allowed is shutdown.

It also defines the time of how long a previous torque direction is hold after direction goes to undefined

</L-2>
                                            </DESC>
                                            <CATEGORY>VALUE</CATEGORY>
