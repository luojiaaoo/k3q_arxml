                                                <CONSTANT-REFERENCE>
                                                    <SHORT-LABEL>STCWkt_f_CapFactAtCluPed</SHORT-LABEL>
                                                    <CONSTANT-REF DEST="CONSTANT-SPECIFICATION">/STCW_pkg/STCW_dt/Ground/STCWkt_f_CapFactAtCluPed</CONSTANT-REF>
