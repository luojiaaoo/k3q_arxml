                                        <PARAMETER-DATA-PROTOTYPE UUID="f648e311-782c-55f8-a207-db84de6b9b77">
                                            <SHORT-NAME>STCWke_b_IdleLimOnlyOnIsg</SHORT-NAME>
                                            <DESC>
                                                <L-2 L="FOR-ALL">###Description
Decides if minimum allowed P1 torque from the idle controller is applied only on ISG (i.e. engine capability part is unlimited), or on P1 (i.e. engine + ISG is limited).

###Usage
Set to TRUE to apply limit only on ISG capabilities.

###Calibration Note
This calibration has no function:
   on wheel capabilities, if STCWke_b_LimitWheelCapabilityWithIdleLim is FALSE.
   on P1 capabilities, if STCWke_b_LimitWheelCapabilityWithIdleLim and STCWke_b_LimitP1CapabilityWithIdleLimit both are FALSE.
</L-2>
                                            </DESC>
                                            <CATEGORY>BOOLEAN</CATEGORY>
                                            <SW-DATA-DEF-PROPS>
                                                <SW-DATA-DEF-PROPS-VARIANTS>
                                                    <SW-DATA-DEF-PROPS-CONDITIONAL>
                                                        <SW-CALIBRATION-ACCESS>READ-WRITE</SW-CALIBRATION-ACCESS>
                                                        <SW-IMPL-POLICY>STANDARD</SW-IMPL-POLICY>
                                                    </SW-DATA-DEF-PROPS-CONDITIONAL>
                                                </SW-DATA-DEF-PROPS-VARIANTS>
                                            </SW-DATA-DEF-PROPS>
                                            <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/STCW_pkg/STCW_dt/ApplDataTypes/T_BOOLEAN</TYPE-TREF>
                                            <INIT-VALUE>
                                                <CONSTANT-REFERENCE>
                                                    <SHORT-LABEL>STCWke_b_IdleLimOnlyOnIsg</SHORT-LABEL>
                                                    <CONSTANT-REF DEST="CONSTANT-SPECIFICATION">/STCW_pkg/STCW_dt/Ground/STCWke_b_IdleLimOnlyOnIsg</CONSTANT-REF>
                                                </CONSTANT-REFERENCE>
                                            </INIT-VALUE>
                                        </PARAMETER-DATA-PROTOTYPE>
