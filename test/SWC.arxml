                                        <PARAMETER-DATA-PROTOTYPE UUID="4e141d6a-9e40-5b4b-ad84-83172780e8fa">
                                            <SHORT-NAME>STCWke_cnt_DelayBitFlipNonCloseDrvLn</SHORT-NAME>
                                            <DESC>
                                                <L-2 L="FOR-ALL">Used inte the functionality to remove the Allowed minimum P1 torque to put on wheels when the drivline is open. This calibrations delays the of when driveline is open and is mainly used to secure for bitflips between e.g. shift active and driveline open</L-2>
                                            </DESC>
                                            <CATEGORY>VALUE</CATEGORY>
                                            <SW-DATA-DEF-PROPS>
                                                <SW-DATA-DEF-PROPS-VARIANTS>
                                                    <SW-DATA-DEF-PROPS-CONDITIONAL>
                                                        <SW-CALIBRATION-ACCESS>READ-WRITE</SW-CALIBRATION-ACCESS>
                                                        <SW-IMPL-POLICY>STANDARD</SW-IMPL-POLICY>
                                                    </SW-DATA-DEF-PROPS-CONDITIONAL>
                                                </SW-DATA-DEF-PROPS-VARIANTS>
                                            </SW-DATA-DEF-PROPS>
                                            <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/STCW_pkg/STCW_dt/ApplDataTypes/T_Cnt_Num_1_1_u16_0to10000</TYPE-TREF>
                                            <INIT-VALUE>
                                                <CONSTANT-REFERENCE>
                                                    <SHORT-LABEL>STCWke_cnt_DelayBitFlipNonCloseDrvLn</SHORT-LABEL>
                                                    <CONSTANT-REF DEST="CONSTANT-SPECIFICATION">/STCW_pkg/STCW_dt/Ground/STCWke_cnt_DelayBitFlipNonCloseDrvLn</CONSTANT-REF>
                                                </CONSTANT-REFERENCE>
                                            </INIT-VALUE>
                                        </PARAMETER-DATA-PROTOTYPE>
                                        <PARAMETER-DATA-PROTOTYPE UUID="231e2b50-9537-52e8-3e90-64d701097f43">
                                            <SHORT-NAME>STCWke_cnt_DelayNonCloseDriveline</SHORT-NAME>
                                            <DESC>
                                                <L-2 L="FOR-ALL">Used inte the functionality to remove the Allowed minimum P1 torque to put on wheels when the drivline is open. This calibrations delays the detection of when the driveline has been opened and therby also delays the time where the allowed negative P1 torque on wheels i removed </L-2>
                                            </DESC>
                                            <CATEGORY>VALUE</CATEGORY>
                                            <SW-DATA-DEF-PROPS>
                                                <SW-DATA-DEF-PROPS-VARIANTS>
                                                    <SW-DATA-DEF-PROPS-CONDITIONAL>
                                                        <SW-CALIBRATION-ACCESS>READ-WRITE</SW-CALIBRATION-ACCESS>
                                                        <SW-IMPL-POLICY>STANDARD</SW-IMPL-POLICY>
                                                    </SW-DATA-DEF-PROPS-CONDITIONAL>
                                                </SW-DATA-DEF-PROPS-VARIANTS>
                                            </SW-DATA-DEF-PROPS>
                                            <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/STCW_pkg/STCW_dt/ApplDataTypes/T_Cnt_Num_1_1_u16_0to10000</TYPE-TREF>
                                            <INIT-VALUE>
                                                <CONSTANT-REFERENCE>
                                                    <SHORT-LABEL>STCWke_cnt_DelayNonCloseDriveline</SHORT-LABEL>
                                                    <CONSTANT-REF DEST="CONSTANT-SPECIFICATION">/STCW_pkg/STCW_dt/Ground/STCWke_cnt_DelayNonCloseDriveline</CONSTANT-REF>
                                                </CONSTANT-REFERENCE>
                                            </INIT-VALUE>
                                        </PARAMETER-DATA-PROTOTYPE>
                                        <PARAMETER-DATA-PROTOTYPE UUID="bb1a40a2-a92a-5a0b-3eee-a05b3e26381a">
                                            <SHORT-NAME>STCWkt_K_BrkRgnRampOut</SHORT-NAME>
                                            <DESC>
                                                <L-2 L="FOR-ALL">###Description
Table with factor for ramping out brake regen capability in low speed.

###Usage
Use to define how the available brake regen torque capability shall be ramped out when approching standstill

###Calibration Note
Don't make to steep and/or to ramp out to close to zero, this will easily introduce oscillations in the driveline


















</L-2>
                                            </DESC>
                                            <CATEGORY>CURVE</CATEGORY>
                                            <SW-DATA-DEF-PROPS>
                                                <SW-DATA-DEF-PROPS-VARIANTS>
                                                    <SW-DATA-DEF-PROPS-CONDITIONAL>
                                                        <SW-CALIBRATION-ACCESS>READ-WRITE</SW-CALIBRATION-ACCESS>
                                                        <SW-IMPL-POLICY>STANDARD</SW-IMPL-POLICY>
                                                    </SW-DATA-DEF-PROPS-CONDITIONAL>
                                                </SW-DATA-DEF-PROPS-VARIANTS>
                                            </SW-DATA-DEF-PROPS>
                                            <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/STCW_pkg/STCW_dt/ApplDataTypes/Appl_STCWkt_K_BrkRgnRampOut</TYPE-TREF>
                                            <INIT-VALUE>
                                                <CONSTANT-REFERENCE>
                                                    <SHORT-LABEL>STCWkt_K_BrkRgnRampOut</SHORT-LABEL>
                                                    <CONSTANT-REF DEST="CONSTANT-SPECIFICATION">/STCW_pkg/STCW_dt/Ground/STCWkt_K_BrkRgnRampOut</CONSTANT-REF>
                                                </CONSTANT-REFERENCE>
                                            </INIT-VALUE>
                                        </PARAMETER-DATA-PROTOTYPE>
