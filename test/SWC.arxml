                                            <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/STCW_pkg/STCW_dt/ApplDataTypes/Appl_STCWkt_r_PartOfTotalCpbyD</TYPE-TREF>
                                            <INIT-VALUE>
                                                <CONSTANT-REFERENCE>
