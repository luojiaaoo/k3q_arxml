                                                </CONSTANT-REFERENCE>
                                            </INIT-VALUE>
                                        </PARAMETER-DATA-PROTOTYPE>
                                        <PARAMETER-DATA-PROTOTYPE UUID="baf9ed2a-b65d-5664-cedf-0126fd125726">
                                            <SHORT-NAME>STCWke_b_UseP1MotorERSCaps</SHORT-NAME>
                                            <DESC>
                                                <L-2 L="FOR-ALL">###Description
This enables the use of ERS capabilities of P1 motor to calculate wheel torque capabilities
###Usage
True in vehicle were the engine is stopped in speed and there is a need to know what capability the we would have at whells if engine was commanded to be running
</L-2>
                                            </DESC>
                                            <CATEGORY>BOOLEAN</CATEGORY>
                                            <SW-DATA-DEF-PROPS>
                                                <SW-DATA-DEF-PROPS-VARIANTS>
                                                    <SW-DATA-DEF-PROPS-CONDITIONAL>
                                                        <SW-CALIBRATION-ACCESS>READ-WRITE</SW-CALIBRATION-ACCESS>
                                                        <SW-IMPL-POLICY>STANDARD</SW-IMPL-POLICY>
                                                    </SW-DATA-DEF-PROPS-CONDITIONAL>
                                                </SW-DATA-DEF-PROPS-VARIANTS>
                                            </SW-DATA-DEF-PROPS>
                                            <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/STCW_pkg/STCW_dt/ApplDataTypes/T_BOOLEAN</TYPE-TREF>
                                            <INIT-VALUE>
                                                <CONSTANT-REFERENCE>
                                                    <SHORT-LABEL>STCWke_b_UseP1MotorERSCaps</SHORT-LABEL>
                                                    <CONSTANT-REF DEST="CONSTANT-SPECIFICATION">/STCW_pkg/STCW_dt/Ground/STCWke_b_UseP1MotorERSCaps</CONSTANT-REF>
                                                </CONSTANT-REFERENCE>
                                            </INIT-VALUE>
                                        </PARAMETER-DATA-PROTOTYPE>
                                        <PARAMETER-DATA-PROTOTYPE UUID="8e8d207c-0f95-53d9-5fcf-42ae8760f4e1">
                                            <SHORT-NAME>STCWke_b_UseP3MotorForBrakeRegenCap</SHORT-NAME>
                                            <DESC>
                                                <L-2 L="FOR-ALL">If true, available P3 Motor torque for brake regen will be used</L-2>
                                            </DESC>
