                                        <PARAMETER-DATA-PROTOTYPE UUID="fc216bb2-0228-507b-14ea-79a0427a3a7e">
                                            <SHORT-NAME>STCWke_M_CpbyGradientLimit</SHORT-NAME>
                                            <DESC>
                                                <L-2 L="FOR-ALL">###Description
Decides how fast capabilities are allowed to increase (Nm/sample).

###usage
Used to avoid that capabilities suddenly become large and non-zero when previously reset by propulsion allowed or DITD etc.

###
Used to prevent oscilations in the system shall not be used to calibrate drivability






</L-2>
                                            </DESC>
                                            <CATEGORY>VALUE</CATEGORY>
                                            <SW-DATA-DEF-PROPS>
                                                <SW-DATA-DEF-PROPS-VARIANTS>
                                                    <SW-DATA-DEF-PROPS-CONDITIONAL>
                                                        <SW-CALIBRATION-ACCESS>READ-WRITE</SW-CALIBRATION-ACCESS>
                                                        <SW-IMPL-POLICY>STANDARD</SW-IMPL-POLICY>
                                                    </SW-DATA-DEF-PROPS-CONDITIONAL>
                                                </SW-DATA-DEF-PROPS-VARIANTS>
                                            </SW-DATA-DEF-PROPS>
                                            <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/STCW_pkg/STCW_dt/ApplDataTypes/T_M_Nm_Float32_0to8000</TYPE-TREF>
                                            <INIT-VALUE>
                                                <CONSTANT-REFERENCE>
                                                    <SHORT-LABEL>STCWke_M_CpbyGradientLimit</SHORT-LABEL>
                                                    <CONSTANT-REF DEST="CONSTANT-SPECIFICATION">/STCW_pkg/STCW_dt/Ground/STCWke_M_CpbyGradientLimit</CONSTANT-REF>
                                                </CONSTANT-REFERENCE>
                                            </INIT-VALUE>
                                        </PARAMETER-DATA-PROTOTYPE>
