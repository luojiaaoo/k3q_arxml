                                            <SHORT-NAME>STCWkn_f_CapFactAtCluPedAxis</SHORT-NAME>
                                            <DESC>
                                                <L-2 L="FOR-ALL">Axis for scaling capabilities with relative distance from clutch drag point. [-1, 1]</L-2>
                                            </DESC>
                                            <CATEGORY>COM_AXIS</CATEGORY>
                                            <SW-DATA-DEF-PROPS>
                                                <SW-DATA-DEF-PROPS-VARIANTS>
                                                    <SW-DATA-DEF-PROPS-CONDITIONAL>
                                                        <SW-CALIBRATION-ACCESS>READ-WRITE</SW-CALIBRATION-ACCESS>
                                                        <SW-IMPL-POLICY>STANDARD</SW-IMPL-POLICY>
                                                    </SW-DATA-DEF-PROPS-CONDITIONAL>
                                                </SW-DATA-DEF-PROPS-VARIANTS>
                                            </SW-DATA-DEF-PROPS>
                                            <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/STCW_pkg/STCW_dt/ApplDataTypes/Appl_STCWkn_f_CapFactAtCluPedAxis</TYPE-TREF>
                                            <INIT-VALUE>
                                                <CONSTANT-REFERENCE>
                                                    <SHORT-LABEL>STCWkn_f_CapFactAtCluPedAxis</SHORT-LABEL>
                                                    <CONSTANT-REF DEST="CONSTANT-SPECIFICATION">/STCW_pkg/STCW_dt/Ground/STCWkn_f_CapFactAtCluPedAxis</CONSTANT-REF>
                                                </CONSTANT-REFERENCE>
                                            </INIT-VALUE>
                                        </PARAMETER-DATA-PROTOTYPE>
                                        <PARAMETER-DATA-PROTOTYPE UUID="31cfefbf-1395-5275-f4b3-935fe1886f73">
                                            <SHORT-NAME>STCWkt_f_CapFactAtCluPed</SHORT-NAME>
                                            <DESC>
                                                <L-2 L="FOR-ALL">###Description
Output table for scaling capabilities depending on distance from clutch grippoint

###Usage
Use this table to calibrate how the P3/P4 motor capabilities shall be scaled as function of clutch pedal posistion

###Calibration Note
This is to be used for manual transmission and is only used depending on the calibration STCWke_e_CluToEmFactMethod
</L-2>
                                            </DESC>
